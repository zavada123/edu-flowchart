{
  "name": "edu-flowchart",
  "version": "0.1.0",
  "description": "Тренажер блок-схем: учень складає блок-схему, виконує її покроково, а тренажер перевіряє результат",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
